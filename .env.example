# ==============================================================================
# GALVA-DB — Environment Configuration (DEV ONLY)
# DO NOT COMMIT REAL SECRETS. Copy to .env and fill in locally.
# ==============================================================================

# Microsoft SQL Server 2022 (developer/local only)
# Avoid '!' — bash history expansion can mangle it.
MSSQL_SA_PASSWORD=GalvaDev2026_StrongPwd
MSSQL_PID=developer
ACCEPT_EULA=Y
MSSQL_LCID=1033

# Host port mapping (container always listens on 1433)
MSSQL_HOST_PORT=1433
